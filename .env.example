# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
# Local development only: lets the header-based dev identity (x-dev-user-id) work. Never enable on a shared or public server.
DEV_AUTH_ENABLED=true
PORT=4000
# Exact browser origin of Next.js frontend (scheme + host + port, no path).
FRONTEND_URL=http://localhost:3000
# Public base URL used by the frontend API client. Must point at the Express API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Number of reverse proxies in front of the API (0 = none). Needed for correct rate limiting behind a proxy.
TRUST_PROXY=0

# PostgreSQL. POSTGRES_PASSWORD is read by docker-compose; keep it identical to the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-dev-only
DATABASE_URL=postgresql://openvio:change-me-local-dev-only@localhost:5432/openvio_linkedin
DB_POOL_MAX=10
# Hosted database (Aiven, Neon, RDS...): append ?sslmode=require to DATABASE_URL, download the provider's CA certificate,
# save it OUTSIDE git (certs/ is ignored) and point to it. Certificate verification is always on.
# DATABASE_SSL_CA_FILE=certs/aiven-ca.pem

LINKEDIN_MODE=mock
LINKEDIN_CLIENT_ID=mock-client-id
LINKEDIN_CLIENT_SECRET=mock-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/linkedin/callback
LINKEDIN_API_VERSION=202610
LINKEDIN_API_BASE=http://127.0.0.1:4100

# 64 hex characters (32 bytes); REQUIRED for production or live LinkedIn mode. If empty in local mock mode a temporary
# key is used and connections must be re-made after each restart. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

SCHEDULER_INTERVAL_SECONDS=60
MISSED_WINDOW_HOURS=6
STUCK_PUBLISHING_MINUTES=10
MEDIA_MAX_BYTES=5242880
UPLOAD_DIR=./uploads
PUBLIC_API_BASE_URL=http://localhost:4000
SCHEDULER_BATCH_SIZE=20
LINKEDIN_HTTP_TIMEOUT_MS=10000
TOKEN_EXPIRY_WARNING_DAYS=7
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_API_KEY=
# Set to true only to allow a down migration against a production database.
ALLOW_DESTRUCTIVE_MIGRATIONS=false
